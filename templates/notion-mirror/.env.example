NOTION_API_KEY=secret_xxx
GOOGLE_TAG_ID=<%= googleTagId %>
GOOGLE_ANALYTICS_CONSENT_MODE=<%= googleAnalyticsConsentMode ? 'true' : 'false' %>
SHORT_LINK_REDIRECT_STATUS=<%= shortLinkRedirectStatus %>
HIDE_MOBILE_COVER_IMAGES=false
ALWAYS_USE_SITE_LOGO_FAVICON=false
SHORT_LINKS_JSON=<%- jsonInline(shortLinks) %>

# Sync daemon (sync/daemon.ts), optional
SYNC_WRITE_URL=https://<%= domainName %>
SYNC_WRITE_SECRET=
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
SYNC_INTERVAL_MIN=15
FULL_RUN_HOUR=4
KV_DAILY_BUDGET=900
